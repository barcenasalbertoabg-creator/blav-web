# Copia este archivo como .env.local y rellena los valores. Nunca subas valores reales.

# ── Sanity ──────────────────────────────────────────────────
# Project ID en: https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token solo para scripts de migración (local)
SANITY_API_TOKEN=
# Secreto del webhook de Sanity → /api/revalidate (el mismo valor en Sanity y en Vercel)
SANITY_REVALIDATE_SECRET=

# ── Asistente IA ────────────────────────────────────────────
# Solo servidor: nunca con prefijo NEXT_PUBLIC_
ANTHROPIC_API_KEY=
# true para encenderlo; false lo apaga al instante (botón oculto, API responde 503)
ASISTENTE_ENABLED=false
ASISTENTE_MODEL=claude-haiku-5-5
# Registro anónimo de preguntas. Dejar en false hasta validar el aviso de privacidad.
ASISTENTE_LOG_PREGUNTAS=false

# ── Upstash Redis (rate limit y métricas del asistente) ─────
# Vercel → Storage → Upstash (Marketplace) crea KV_REST_API_URL / KV_REST_API_TOKEN
# automáticamente; también se aceptan estos nombres:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
